{
  "name": "querier",
  "version": "0.0.1",
  "description": "A tiny, typed PostgreSQL query executor built directly on pg.",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "querier": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./checker": {
      "types": "./dist/checker.d.ts",
      "import": "./dist/checker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && bunx tsc -p tsconfig.build.json",
    "check": "bunx tsc --noEmit",
    "lint": "bun lint --max-warnings 0",
    "lint:fix": "bun lint --fix",
    "example": "bun run build && bunx tsc --noEmit -p example/tsconfig.json && bun example/index.ts",
    "test": "bun test",
    "test:unit": "bun test test/*.test.ts",
    "test:integration": "bun test test/integration",
    "prepack": "bun run lint && bun run check && bun test && bun run build"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "pg",
    "sql",
    "typescript"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "dependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "pg-query-stream": "^4.17.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=20"
  }
}
